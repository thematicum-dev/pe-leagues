NEXT_PUBLIC_SUPABASE_URL=https://<dein-projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dein-anon-key>

# Nur für den Admin-Bereich (app/admin/) nötig, niemals im Browser sichtbar:
# Supabase-Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=<dein-service-role-key>

# Öffentliche Adresse der Seite, für Vorschaubilder und Links (optional;
# auf Vercel wird sonst die Produktionsadresse des Projekts genommen).
# NEXT_PUBLIC_SITE_URL=https://…

# Erst setzen, wenn Impressum, Datenschutz und Nutzungsbedingungen ausgefüllt
# und geprüft sind — blendet den Entwurfshinweis auf diesen Seiten aus.
# NEXT_PUBLIC_LEGAL_READY=1
